---
import "@fontsource-variable/inter";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  /** Page title; suffixed with "| Mercury Partners" (mirrors the Next.js title template). */
  title?: string;
  description: string;
}

const DEFAULT_TITLE = "Mercury Partners | Permanent Capital for Founder-Owned Businesses";
const METADATA_BASE = "https://www.mercfund.com";

const { title, description } = Astro.props;
const fullTitle = title ? `${title} | Mercury Partners` : DEFAULT_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="build-check" content="rehearsal-1" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Mercury Partners" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${METADATA_BASE}/images/mercury-meeting.jpg`} />
    <script is:inline>document.documentElement.classList.add("js-anim");</script>
  </head>
  <body>
    <Nav />
    <main><slot /></main>
    <Footer />
    <script is:inline>
      // Settled entrance animations: rise + fade on scroll into view, gentle
      // sibling stagger. No-JS and reduced-motion users see content instantly
      // (the hidden state is gated on html.js-anim + no-preference in CSS).
      (function () {
        var targets = document.querySelectorAll(
          [
            ".page-hero__inner > *",
            ".hero__grid > div:first-child > *",
            ".hero__art",
            ".section-head",
            ".card",
            ".numeral-item",
            ".stat-card",
            ".pf-card",
            ".split > *",
            ".quote",
            ".faq",
            ".cta-band__inner > *",
            ".contact-grid > *",
          ].join(",")
        );
        if (!targets.length || !("IntersectionObserver" in window)) {
          document.documentElement.classList.remove("js-anim");
          return;
        }
        var groupIndex = new Map();
        targets.forEach(function (el) {
          var p = el.parentElement;
          var i = groupIndex.get(p) || 0;
          groupIndex.set(p, i + 1);
          el.style.transitionDelay = Math.min(i * 90, 540) + "ms";
          el.addEventListener(
            "transitionend",
            function () {
              el.style.transitionDelay = "";
            },
            { once: true }
          );
        });
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("in-view");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        targets.forEach(function (t) {
          io.observe(t);
        });
      })();
    </script>
  </body>
</html>
