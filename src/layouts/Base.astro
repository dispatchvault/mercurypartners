---
import "@fontsource-variable/inter";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { abs, canonicalFor, pageGraph } from "../lib/seo";

interface Props {
  /** Short page name; rendered as "<title> | Mercury Partners" unless seoTitle is given. */
  title?: string;
  /** Full <title> override for search results (keep under ~60 characters). */
  seoTitle?: string;
  /** Meta description for search results (aim for 140–160 characters). */
  description: string;
  /** schema.org type for this page: WebPage, AboutPage, ContactPage, CollectionPage. */
  pageType?: string;
  /** Breadcrumb trail after Home, for search results. */
  crumbs?: { name: string; path: string }[];
  /** JSON-LD node this page is primarily about. */
  mainEntity?: object;
  /** Extra JSON-LD nodes for this page (FAQ, item lists). */
  schema?: object[];
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const DEFAULT_TITLE = "Mercury Partners | Permanent Capital for Founder-Owned Businesses";
const OG_IMAGE = abs("/images/og-mercury-partners.jpg");

const { title, seoTitle, description, pageType, crumbs, mainEntity, schema, noindex } = Astro.props;
const fullTitle = seoTitle ?? (title ? `${title} | Mercury Partners` : DEFAULT_TITLE);
const canonical = canonicalFor(Astro.url.pathname);
const jsonLd = pageGraph({ url: canonical, title: fullTitle, description, pageType, crumbs, mainEntity, extra: schema });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#0f2236" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mercury Partners" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mercury Partners: permanent capital for founder-owned businesses" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Mercury Partners summary for AI assistants" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add("js-anim");</script>
  </head>
  <body>
    <Nav />
    <main><slot /></main>
    <Footer />
    <script is:inline>
      // Settled entrance animations: rise + fade on scroll into view, gentle
      // sibling stagger. No-JS and reduced-motion users see content instantly
      // (the hidden state is gated on html.js-anim + no-preference in CSS).
      (function () {
        var targets = document.querySelectorAll(
          [
            ".page-hero__inner > *",
            ".hero__grid > div:first-child > *",
            ".hero__art",
            ".section-head",
            ".card",
            ".numeral-item",
            ".stat-card",
            ".pf-card",
            ".split > *",
            ".quote",
            ".faq",
            ".cta-band__inner > *",
            ".contact-grid > *",
          ].join(",")
        );
        if (!targets.length || !("IntersectionObserver" in window)) {
          document.documentElement.classList.remove("js-anim");
          return;
        }
        var groupIndex = new Map();
        targets.forEach(function (el) {
          var p = el.parentElement;
          var i = groupIndex.get(p) || 0;
          groupIndex.set(p, i + 1);
          el.style.transitionDelay = Math.min(i * 90, 540) + "ms";
          el.addEventListener(
            "transitionend",
            function () {
              el.style.transitionDelay = "";
            },
            { once: true }
          );
        });
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add("in-view");
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
        );
        targets.forEach(function (t) {
          io.observe(t);
        });
      })();
    </script>
  </body>
</html>
