---
import Base from "../layouts/Base.astro";
import { ORG_ID, faqPage, canonicalFor } from "../lib/seo";
import SectionHeader from "../components/SectionHeader.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";

type StrategyCard = {
  title: string;
  items?: string[];
  groups?: { title: string; items: string[] }[];
};

const strategy: StrategyCard[] = [
  {
    title: "The Right Business",
    items: [
      "Structural barriers to entry",
      "Non-discretionary demand",
      "IP or process advantages",
      "Meaningful switching costs",
      "Fragmented competitive landscape",
    ],
  },
  {
    title: "Financial Criteria",
    items: [
      "Revenue: $10M – $50M",
      "EBITDA: $1M – $4M",
      "Transaction Size: $5M – $50M",
      "Geography: United States",
    ],
  },
  {
    title: "Transaction Type",
    items: [
      "Majority or control investments",
      "Founder transitions & recapitalizations",
      "Management buyouts",
      "Strategic add-on acquisitions",
    ],
  },
  {
    title: "Industry Focus",
    groups: [
      {
        title: "Business Services",
        items: [
          "Equipment maintenance and repair",
          "Testing, inspection, and calibration",
          "Facilities management",
          "Specialty field services",
          "Safety and compliance",
        ],
      },
      {
        title: "Healthcare Services",
        items: [
          "Medical equipment maintenance and repair",
          "Healthcare equipment testing and calibration",
          "Medical products and distribution",
          "Healthcare facility support services",
          "Sterilization and infection control",
        ],
      },
    ],
  },
];


// Questions advisors and AI assistants ask most. Mirrored into structured data automatically.
const advisorFaqs = [
  {
    q: "What size companies does Mercury Partners invest in?",
    a: "Mercury invests in U.S. founder-owned companies with $10 million to $50 million in revenue and $1 million to $4 million in EBITDA. Transaction sizes generally range from $5 million to $50 million.",
  },
  {
    q: "Which industries does Mercury focus on?",
    a: "Business services and healthcare services companies that provide critical services to complex or regulated end markets. Examples include equipment maintenance and repair; testing, inspection, and calibration; facilities management; specialty field services; medical products and distribution; and sterilization and infection control.",
  },
  {
    q: "What types of transactions does Mercury pursue?",
    a: "Primarily majority or control investments involving founder transitions and recapitalizations, as well as management buyouts. Mercury also completes strategic add-on acquisitions for the companies it owns.",
  },
  {
    q: "What makes a business a strong fit?",
    a: "Technical expertise, high barriers to entry, recurring or non-discretionary demand, meaningful switching costs, and a fragmented competitive landscape.",
  },
  {
    q: "Where does Mercury's capital come from?",
    a: "Mercury invests its own permanent capital. It is not constrained by a fund life or a predetermined exit timeline, which allows it to own businesses for the long term.",
  },
  {
    q: "Who leads Mercury Partners?",
    a: "Brad de Koning, Founding Partner, has led the firm's investment activities since 1996. He was CEO of DirectMed Imaging for nearly nine years following Mercury's acquisition of the company in 2017.",
  },
  {
    q: "How can advisors share an opportunity?",
    a: "Contact Brad de Koning directly at contact@mercfund.com or (858) 205-1405. If an opportunity is not a fit, we say so quickly, and we work directly with a founder's advisors throughout a transaction.",
  },
];
---

<Base
  title="About"
  seoTitle="About Mercury Partners | Brad de Koning, Founding Partner"
  description="Led by Brad de Koning since 1996, Mercury Partners makes control investments in founder transitions, recapitalizations, and management buyouts."
  pageType="AboutPage"
  crumbs={[{ name: "About", path: "/about/" }]}
  mainEntity={{ "@id": ORG_ID }}
  schema={[faqPage(canonicalFor("/about/"), advisorFaqs)]}
>
  <section class="page-hero page-hero--dark pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">About Mercury Partners</span>
      <h1 class="h1">
        Investing in <em>Partnership</em>
      </h1>
      <p class="lede muted">
        Mercury Partners has more than 30 years of principal investing and CEO experience
        acquiring and growing lower middle market businesses. We invest our own permanent
        capital and partner with a company's leadership team to build enduring businesses.
      </p>
    </div></div>
  </section>

  <section class="section pad-global">
    <div class="container split leadership-split">
      <div class="split__img">
        <img
          src="/images/brad-de-koning-blazer-grey.jpg"
          alt="Brad de Koning, Founding Partner of Mercury Partners"
          width="800"
          height="800"
        />
      </div>
      <div>
        <span class="eyebrow">Leadership</span>
        <h2 class="h2">
          An Owner's <em>Perspective</em>
        </h2>
        <p class="text-regular muted" style="margin-bottom: 1rem;">
          Brad de Koning is the Founding Partner of Mercury Partners, where he has led the
          firm's investment activities since 1996. Most recently, he was CEO of DirectMed Imaging
          for nearly nine years following Mercury's acquisition of the company in 2017.
        </p>
        <p class="text-regular muted" style="margin-bottom: 0;">
          Having served as both a private equity investor and CEO of two lower middle market companies, Brad has experienced
          ownership and founder transitions from both sides of the table. That perspective
          shapes Mercury's approach to investing and working with leadership teams to build
          long-term value.
        </p>
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container">
      <SectionHeader
        eyebrow="Investment Strategy"
        lede="Mercury focuses on founder-owned, lower middle market businesses providing critical services to complex or regulated end markets. We partner with management teams where our operating experience and capital can support the next stage of growth."
      >
        Disciplined Strategy for <em>Long-Term Ownership</em>
      </SectionHeader>
      <div class="card-grid card-grid--4">
        {
          strategy.map((s) => (
            <div class="card strategy-card">
              <h3 class="card__title">{s.title}</h3>
              {s.groups ? (
                <div class="sector-acc">
                  {s.groups.map((g) => (
                    <div class="sector-acc__item">
                      <button class="sector-acc__q" aria-expanded="false">
                        {g.title}
                        <span class="sector-acc__icon" aria-hidden="true">
                          +
                        </span>
                      </button>
                      <div class="sector-acc__a">
                        <div class="sector-acc__a-inner">
                          <ul class="sector-acc__list">
                            {g.items.map((i) => (
                              <li>{i}</li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <ul class="plainlist">
                  {s.items?.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-grey">
    <div class="container faq-layout">
      <SectionHeader eyebrow="For Advisors & Intermediaries">
        Frequently Asked <em>Questions</em>
      </SectionHeader>
      <Faq items={advisorFaqs} />
    </div>
  </section>

  <CtaBand
    heading="Interested in learning more"
    accent="about Mercury?"
    lede="Start a confidential conversation about your business and what you're considering."
    label="Let's Talk"
  />
</Base>

<script>
  document.querySelectorAll<HTMLElement>(".sector-acc__item").forEach((item) => {
    const q = item.querySelector<HTMLButtonElement>(".sector-acc__q");
    q?.addEventListener("click", () => {
      const open = item.classList.toggle("sector-acc__item--open");
      q.setAttribute("aria-expanded", String(open));
    });
  });
</script>

<style>
  /* leadership section: photo takes a third of the width, text the rest; columns top-aligned;
     photo shown uncropped at its natural aspect ratio */
  .leadership-split { grid-template-columns: 1fr 2fr; align-items: start; gap: 6rem; }
  .leadership-split .split__img img { height: auto; aspect-ratio: auto; }
  @media (max-width: 860px) {
    /* stacked: photo above the text, no wider than 60% of the column, centered */
    .leadership-split { grid-template-columns: 1fr; gap: 3rem; }
    .leadership-split .split__img { max-width: 60%; margin: 0 auto; }
  }
  /* Investment Strategy: the four card subheaders are set in all caps at the same size as the
     sector headers on the Investments page (10% below the standard 1.2rem card title) */
  .strategy-card .card__title { text-transform: uppercase; font-size: 1.08rem; }
</style>
