---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";

const pillars = [
  {
    title: "No Institutional Fund Pressure",
    body: "Mercury is privately funded, enabling full alignment with founder and management team interests above all.",
  },
  {
    title: "No Short-Term Thinking",
    body: "We invest in people, systems, and growth strategies built to last — not financial maneuvers optimized for a quick exit.",
  },
  {
    title: "No Forced Sale Timelines",
    body: "Permanent capital means decisions are driven by long-term value creation, never by a fund's exit requirements.",
  },
];

type StrategyCard = {
  title: string;
  items?: string[];
  groups?: { title: string; items: string[] }[];
};

const strategy: StrategyCard[] = [
  {
    title: "The Right Business",
    items: [
      "Compliance-driven demand",
      "High switching costs",
      "Hard-to-replicate technical expertise",
      "Non-discretionary spend",
    ],
  },
  {
    title: "Financial Criteria",
    items: [
      "Revenue: $10M – $50M",
      "EBITDA: $1M – $4M",
      "Transaction Size: $5M – $50M",
      "Geography: United States only",
    ],
  },
  {
    title: "Transaction Type",
    items: [
      "Majority or control ownership strongly preferred",
      "Acquisitions, MBOs & recapitalizations",
      "Select operational turnarounds",
      "Financial restructurings",
    ],
  },
  {
    title: "Industry Focus",
    groups: [
      {
        title: "Healthcare Services",
        items: [
          "Healthcare diagnostics and monitoring",
          "Medical products and distribution",
          "Repair and maintenance",
          "Sterilization and infection control",
          "Surgical equipment maintenance",
        ],
      },
      {
        title: "Business Services",
        items: [
          "Equipment maintenance and repair",
          "Testing, inspection, and calibration",
          "Facilities management",
          "Specialty field services",
          "Safety and compliance",
        ],
      },
    ],
  },
];

const faqs = [
  {
    q: "How long has Mercury Partners been in business?",
    a: "Mercury Partners was founded in 1996. The firm invested in business services, financial services, and manufacturing companies through its early years, and today operates as a principal investor acquiring and building founder-owned businesses in healthcare services and business services.",
  },
  {
    q: "What experience does Mercury have in business services?",
    a: "Mercury has invested in and supported companies across technology-enabled services, information services, testing and inspection, tradeshow services, and distribution.",
  },
  {
    q: "What experience does Mercury have in healthcare services?",
    a: "Mercury's healthcare experience centers on diagnostics and imaging services, including parts distribution, component repair, and technical service businesses serving hospitals, independent service organizations, and OEMs.",
  },
];
---

<Base
  title="About"
  description="Over 30 years of principal investing and CEO experience dedicated to the lower middle-market. Mercury Partners is built on aligned, long-term ownership."
>
  <section class="page-hero page-hero--dark pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">About Mercury Partners</span>
      <h1 class="h1">
        Investing in <em>Partnership</em>
      </h1>
      <p class="lede muted">
        Over 30 years of principal investing and CEO experience dedicated to the lower
        middle-market.
      </p>
    </div></div>
  </section>

  <section class="section-sm pad-global scheme-cool">
    <div class="container">
      <div class="card-grid card-grid--3">
        {
          pillars.map((p) => (
            <div class="card card--hover">
              <h3 class="card__title">{p.title}</h3>
              <p class="card__body">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global">
    <div class="container split">
      <div class="split__img">
        <img
          src="/images/brad-profile.jpg"
          alt="Brad de Koning, Founding Partner of Mercury Partners"
          width="800"
          height="680"
        />
      </div>
      <div>
        <span class="eyebrow">Leadership</span>
        <h2 class="h2">
          Guided by Experience and <em>Accountability</em>
        </h2>
        <p class="text-regular muted" style="margin-bottom: 1rem;">
          Brad de Koning is the Founding Partner of Mercury Partners, where he leads the
          firm's investment strategy and works closely with management teams to support
          growth, continuity, and value creation.
        </p>
        <p class="text-regular muted" style="margin-bottom: 1rem;">
          Having served as the CEO of two companies and as a private equity managing director,
          Mr. de Koning brings a combination of deal-making expertise and hands-on operating
          experience. He has been through the founder transition process from both sides of the
          table — and understands the nuances that make each partnership unique.
        </p>
        <p class="text-regular muted" style="margin-bottom: 2.75rem;">
          Mercury Partners is built on the belief that the best outcomes for founders,
          employees, and investors are achieved through aligned, long-term ownership — not
          financial engineering or exit timelines.
        </p>
        <p class="text-regular" style="margin-bottom: 0.5rem;">
          <strong>Brad de Koning</strong> · Founding Partner
        </p>
        <ul class="checklist">
          <li>Directly involved from investment through long-term partnership</li>
          <li>Deep expertise across healthcare and business services</li>
          <li>Track record across 22+ lower middle-market investments</li>
          <li>Phoenix House of California — Board member since 2008, Finance Committee Chair</li>
          <li>Member, Young Presidents' Organization since 2007</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container">
      <SectionHeader
        eyebrow="Investment Strategy"
        lede="Mercury focuses on founder-owned, lower middle-market companies that align with our long-term, partnership-driven approach. We seek businesses with durable demand, embedded customer relationships, and leadership teams ready to grow with a permanent capital partner."
      >
        Disciplined Strategy for <em>Long-Term Partners</em>
      </SectionHeader>
      <div class="card-grid card-grid--4">
        {
          strategy.map((s) => (
            <div class="card">
              <h3 class="card__title">{s.title}</h3>
              {s.groups ? (
                <div class="sector-acc">
                  {s.groups.map((g) => (
                    <div class="sector-acc__item">
                      <button class="sector-acc__q" aria-expanded="false">
                        {g.title}
                        <span class="sector-acc__icon" aria-hidden="true">
                          +
                        </span>
                      </button>
                      <div class="sector-acc__a">
                        <div class="sector-acc__a-inner">
                          <ul class="sector-acc__list">
                            {g.items.map((i) => (
                              <li>{i}</li>
                            ))}
                          </ul>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <ul class="plainlist">
                  {s.items?.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-grey">
    <div class="container faq-layout">
      <SectionHeader eyebrow="About the Firm">
        More <em>Questions</em>
      </SectionHeader>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  document.querySelectorAll<HTMLElement>(".sector-acc__item").forEach((item) => {
    const q = item.querySelector<HTMLButtonElement>(".sector-acc__q");
    q?.addEventListener("click", () => {
      const open = item.classList.toggle("sector-acc__item--open");
      q.setAttribute("aria-expanded", String(open));
    });
  });
</script>
