---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page Not Found"
  description="The page you're looking for isn't here. Mercury Partners invests permanent capital in founder-owned business services and healthcare services companies."
  noindex
>
  <section class="page-hero page-hero--dark pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">Page Not Found</span>
      <h1 class="h1">
        This page has <em>moved</em>
      </h1>
      <p class="lede muted">
        The page you were looking for isn't here. You can find our approach, investment
        criteria, and representative investments from the links below.
      </p>
      <div class="btn-group" style="margin-top: 2rem;">
        <a href="/" class="btn btn--ghost-on-navy">HOME</a>
        <a href="/contact/" class="btn btn--on-navy">START A CONVERSATION</a>
      </div>
    </div></div>
  </section>
</Base>
