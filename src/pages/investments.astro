---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatBand from "../components/StatBand.astro";
import CtaBand from "../components/CtaBand.astro";

const companies = [
  {
    name: "DirectMed",
    img: "/images/directmed.jpg",
    desc: "Provider of imaging parts for MRI and CT systems. Grew through organic initiatives and strategic acquisitions to become the market leader.",
  },
  {
    name: "LBN Medical",
    img: "/images/lbn-medical.jpg",
    desc: "Diagnostic imaging systems and parts provider serving ISOs, hospitals, and imaging centers across more than 40 countries.",
  },
  {
    name: "Medical Systems Tech",
    img: "/images/medical-systems-tech.jpg",
    desc: "Component-level repair and testing provider specializing in highly technical repairs for diagnostic imaging equipment.",
  },
  {
    name: "Richardson Healthcare",
    img: "/images/richardson.jpg",
    desc: "Provider of Toshiba diagnostic imaging parts and training services, along with Siemens CT X-ray tube distribution.",
  },
  {
    name: "ScanMed",
    img: "/images/scanmed.jpg",
    desc: "Provider of specialized MRI coil design, manufacturing, and repair services for hospital systems and imaging centers nationwide.",
  },
  {
    name: "Technical Prospects",
    img: "/images/technical-prospects.jpg",
    desc: "Provider of parts, training, and technical services for Siemens diagnostic imaging systems.",
  },
  {
    name: "Titanium Medical Imaging",
    img: "/images/titanium.jpg",
    desc: "Provider of parts and technical services for Toshiba diagnostic imaging systems, serving independent service organizations and hospitals nationwide.",
  },
  {
    name: "Undisclosed",
    img: "/images/undisclosed-mri.jpg",
    desc: "Provider of diagnostic imaging parts with a strategic sourcing model spanning CT, MRI, mammography, X-ray, and ultrasound.",
    /* the other photos carry their logo baked in; this one gets an overlaid wordmark instead */
    logo: "/images/undisclosed-thin.png",
    /* landscape photo in a square tile: favor the right side so less blank wall shows */
    imgPosition: "80% 50%",
  },
];

const sectors = [
  {
    title: "Business Services",
    items: [
      "Equipment maintenance and repair",
      "Testing, inspection, and calibration",
      "Facilities management",
      "Specialty field services",
      "Safety and compliance",
    ],
  },
  {
    title: "Healthcare Services",
    items: [
      "Medical equipment maintenance and repair",
      "Healthcare equipment testing and calibration",
      "Medical products and distribution",
      "Healthcare facility support services",
      "Sterilization and infection control",
    ],
  },
];
---

<Base
  title="Investments"
  description="Representative investments by Mercury Partners: acquisitions and transactions in lower middle market business services and healthcare services over 30 years."
>
  <section class="page-hero page-hero--dark pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">Track Record</span>
      <h1 class="h1">
        Representative <em>Investments</em>
      </h1>
      <p class="lede muted">
        Over 30 years of investing in lower middle market businesses across business services
        and healthcare services.
      </p>
    </div></div>
  </section>

  <section class="section-sm pad-global scheme-cool">
    <div class="container">
      <StatBand
        bare
        stats={[
          { num: "24", label: "Investments" },
          { num: "30+", label: "Years Investing" },
          { num: "70%+", label: "Business & Healthcare Services" },
          { num: "92%", label: "Founder-Owned" },
        ]}
      />
    </div>
  </section>

  <section class="section pad-global">
    <div class="container">
      <SectionHeader
        eyebrow="Select Investments"
        lede="Representative investments from the past decade, reflecting our experience acquiring, investing in, and growing lower middle market businesses."
      >
        A Track Record of <em>Building Businesses</em>
      </SectionHeader>
      <div class="portfolio-grid">
        {
          companies.map((c) => (
            <article class:list={["pf-card", c.logo && "pf-card--washed"]}>
              <button class="pf-card__toggle" type="button" aria-expanded="false" aria-label={`Show details for ${c.name}`}>
                <span aria-hidden="true"></span><span aria-hidden="true"></span>
              </button>
              <div class="pf-card__img">
                <img src={c.img} alt={c.name} width="640" height="400" loading="lazy" style={c.imgPosition ? `object-position: ${c.imgPosition};` : undefined} />
              </div>
              {c.logo && <img class="pf-card__logo" src={c.logo} alt="" aria-hidden="true" loading="lazy" />}
              <div class="pf-card__body">
                <h3 class="pf-card__title">{c.name}</h3>
                <p class="pf-card__desc">{c.desc}</p>
                <div class="pf-card__tags">
                  <span class="tag">Healthcare Services</span>
                  <span class="tag">Buyout</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container">
      <SectionHeader eyebrow="Industry Focus">
        Where <em>We Invest</em>
      </SectionHeader>
      <div class="card-grid card-grid--2">
        {
          sectors.map((s) => (
            <div class="card sector-card">
              <h3 class="card__title">{s.title}</h3>
              <ul class="plainlist">
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    heading="Thinking about"
    accent="what comes next?"
    lede="Start a confidential conversation about your business, your objectives, and the possibilities ahead."
    label="Let's Talk"
  />
</Base>

<script>
  // Touch devices have no hover, so the detail panel opens on tap instead.
  // One card open at a time; tapping it again, another card, or outside closes it.
  const touch = window.matchMedia("(hover: none)");
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".pf-card"));

  function setOpen(card: HTMLElement, open: boolean) {
    card.classList.toggle("is-open", open);
    card.querySelector(".pf-card__toggle")?.setAttribute("aria-expanded", String(open));
  }
  function closeAll(except?: HTMLElement) {
    cards.forEach((c) => c !== except && setOpen(c, false));
  }

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      if (!touch.matches) return;
      const open = !card.classList.contains("is-open");
      closeAll(card);
      setOpen(card, open);
    });
  });
  document.addEventListener("click", (e) => {
    if (touch.matches && !(e.target as Element).closest(".pf-card")) closeAll();
  });
</script>

<style>
  /* overlaid wordmark for a tile whose photo has no logo baked in. Centered at about two-thirds
     of the tile width to match the optical size of the other logos; no z-index so it sits above
     the photo but beneath the hover wash and detail panel, exactly like those logos do. */
  /* the supplied photos carry a light white wash baked in (roughly 40%, with muted color). A
     raw photo used with an overlaid wordmark gets the same wash here so it matches its neighbors. */
  .pf-card--washed .pf-card__img::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.42);
    pointer-events: none;
  }
  .pf-card--washed .pf-card__img img { filter: saturate(0.75); }
  .pf-card__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 66%;
    height: auto;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  /* Industry Focus: the two sector headers are set in all caps, 10% smaller than the
     standard card title (1.2rem) to offset the extra visual weight of capitals */
  .sector-card .card__title { text-transform: uppercase; font-size: 1.08rem; }
</style>
