---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatBand from "../components/StatBand.astro";
import CtaBand from "../components/CtaBand.astro";

const companies = [
  {
    name: "DirectMed",
    img: "/images/directmed.jpg",
    desc: "Provider of imaging parts for MRI and CT systems. Grew through organic initiatives and strategic acquisitions to become the market leader.",
  },
  {
    name: "LBN Medical",
    img: "/images/lbn-medical.jpg",
    desc: "Diagnostic imaging systems and parts provider serving ISOs, hospitals, and imaging centers across more than 40 countries.",
  },
  {
    name: "Medical Systems Tech",
    img: "/images/medical-systems-tech.jpg",
    desc: "Component-level repair and testing provider specializing in highly technical repairs for diagnostic imaging equipment.",
  },
  {
    name: "UNDISCLOSED",
    img: "/images/undisclosed-mri.jpg",
    desc: "Provider of diagnostic imaging parts with a strategic sourcing model spanning CT, MRI, mammography, X-ray, and ultrasound.",
    /* no logo in the photo, so the name is shown on the resting card too */
    frontLabel: true,
    /* landscape photo in a square tile: favor the right side so less blank wall shows */
    imgPosition: "80% 50%",
  },
  {
    name: "Richardson Healthcare",
    img: "/images/richardson.jpg",
    desc: "Provider of Toshiba diagnostic imaging parts and training services, along with Siemens CT X-ray tube distribution.",
  },
  {
    name: "ScanMed",
    img: "/images/scanmed.jpg",
    desc: "Provider of specialized MRI coil design, manufacturing, and repair services for hospital systems and imaging centers nationwide.",
  },
  {
    name: "Technical Prospects",
    img: "/images/technical-prospects.jpg",
    desc: "Provider of parts, training, and technical services for Siemens diagnostic imaging systems.",
  },
  {
    name: "Titanium Medical Imaging",
    img: "/images/titanium.jpg",
    desc: "Provider of parts and technical services for Toshiba diagnostic imaging systems, serving independent service organizations and hospitals nationwide.",
  },
];

const sectors = [
  {
    title: "Business Services",
    items: [
      "Equipment maintenance and repair",
      "Testing, inspection, and calibration",
      "Facilities management",
      "Specialty field services",
      "Safety and compliance",
    ],
  },
  {
    title: "Healthcare Services",
    items: [
      "Healthcare diagnostics and monitoring",
      "Medical products and distribution",
      "Medical equipment repair and maintenance",
      "Sterilization and infection control",
    ],
  },
];
---

<Base
  title="Investments"
  description="Representative investments by Mercury Partners: acquisitions and transactions in lower middle market healthcare and business services over 30+ years."
>
  <section class="page-hero page-hero--dark pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">Track Record</span>
      <h1 class="h1">
        Representative <em>Investments</em>
      </h1>
      <p class="lede muted">
        A 30+ year track record investing in lower middle market businesses across healthcare
        and business services.
      </p>
    </div></div>
  </section>

  <section class="section-sm pad-global scheme-cool">
    <div class="container">
      <StatBand
        bare
        stats={[
          { num: "24", label: "Investments" },
          { num: "30+", label: "Years Investing" },
          { num: "70%+", label: "Healthcare & Business Services" },
          { num: "92%", label: "Founder-Owned" },
        ]}
      />
    </div>
  </section>

  <section class="section pad-global">
    <div class="container">
      <SectionHeader
        eyebrow="Select Investments"
        lede="Representative investments from the past decade, reflecting our experience acquiring, operating, and growing lower middle market businesses."
      >
        A Track Record of <em>Building Businesses</em>
      </SectionHeader>
      <div class="portfolio-grid">
        {
          companies.map((c) => (
            <article class="pf-card">
              <div class="pf-card__img">
                <img src={c.img} alt={c.name} width="640" height="400" loading="lazy" style={c.imgPosition ? `object-position: ${c.imgPosition};` : undefined} />
              </div>
              {c.frontLabel && <span class="pf-card__front-label" aria-hidden="true">{c.name}</span>}
              <div class="pf-card__body">
                <h3 class="pf-card__title">{c.name}</h3>
                <p class="pf-card__desc">{c.desc}</p>
                <div class="pf-card__tags">
                  <span class="tag">Healthcare Services</span>
                  <span class="tag">Buyout</span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container">
      <SectionHeader eyebrow="Industry Focus">
        Where <em>We Invest</em>
      </SectionHeader>
      <div class="card-grid card-grid--2">
        {
          sectors.map((s) => (
            <div class="card">
              <h3 class="card__title">{s.title}</h3>
              <ul class="plainlist">
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    heading="Thinking about"
    accent="what comes next?"
    lede="Start a confidential conversation about your business, your objectives, and the possibilities ahead."
    label="Let's Talk"
  />
</Base>

<style>
  /* resting-state name for a card whose photo carries no logo; fades out as the hover panel takes over */
  .pf-card__front-label {
    position: absolute;
    top: 1.75rem;
    left: 1.75rem;
    z-index: 1;
    padding: 0.3rem 0.6rem;
    background: rgba(26, 53, 87, 0.65); /* navy at 65% so the photo shows through */
    color: var(--white);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: opacity 0.4s ease;
  }
  .pf-card:hover .pf-card__front-label,
  .pf-card:focus-within .pf-card__front-label { opacity: 0; }
  @media (hover: none) {
    /* touch: the info panel is always shown, so the label would duplicate the title */
    .pf-card__front-label { display: none; }
  }
</style>
