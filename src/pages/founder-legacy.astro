---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatBand from "../components/StatBand.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";

const stays = [
  {
    lead: "Your name and brand.",
    body: "The business keeps its identity in the market. Customers see continuity, not a rebrand.",
  },
  {
    lead: "Your team.",
    body: "We back management rather than replace it. Mercury does not install itself in the operating seat.",
  },
  {
    lead: "Your customer relationships.",
    body: "We don't renegotiate terms or reassign accounts. New ownership doesn't mean reinventing your commercial playbook.",
  },
  {
    lead: "Your culture.",
    body: "Culture is the hardest asset to rebuild and the easiest to destroy. We don't arrive with a new mission, vision, and set of values for a team that already has them.",
  },
];

const strengthens = [
  {
    lead: "Access to capital.",
    body: "Growth investments, major equipment purchases, and acquisitions no longer compete with your personal balance sheet.",
  },
  {
    lead: "Systems and reporting.",
    body: "Financial visibility and discipline to execute an operating plan, not to satisfy a lender.",
  },
  {
    lead: "Strategic capability.",
    body: "A partner in the room for the decisions founders usually make alone: pricing, hiring, acquisitions, and capital allocation.",
  },
  {
    lead: "An owner who has operated.",
    body: "We have run companies through recessions and credit crises, not just underwritten deals from a distance.",
  },
];

const steps = [
  {
    title: "A confidential conversation",
    body: "No bankers, no process, no obligation. We learn about the business and what you want the outcome to look like.",
  },
  {
    title: "A direct answer on fit",
    body: "If Mercury is not the right buyer, we say so quickly. A fast no is worth more to a founder than a slow maybe.",
  },
  {
    title: "A structure built to your goals",
    body: "Full exit, partial rollover, a defined transition period, or a continued board role. Structure follows the founder's objective — that conversation happens early and openly.",
  },
  {
    title: "Terms before diligence",
    body: "You receive a written valuation reflecting the structure we discussed before we ask you to open the books. Founders should know the number before committing time to a process.",
  },
  {
    title: "Diligence without disruption",
    body: "The process stays tight and confidential so your team stays focused on the business.",
  },
  {
    title: "Continuity from day one",
    body: "No integration into a larger platform, no restructuring at close. The business keeps running the way it ran.",
  },
];

const faqs = [
  {
    q: "How does Mercury's long-term focus benefit the business?",
    a: "It allows leadership teams to invest in people, systems, and growth strategies that create durable value rather than short-term financial results. Long-term thinking attracts the best talent and deepest customer relationships.",
  },
  {
    q: "Will I need to stay on after the sale?",
    a: "That is entirely the founder's decision, and it is one of the first things we discuss. Some founders want a clean exit at closing; others stay through a defined transition or retain a board role. Mercury backs a management team rather than running the business day to day, so the structure is built around what works for you.",
  },
  {
    q: "What happens to my employees?",
    a: "Mercury buys businesses because of the people who built them. We back existing management and invest in the team rather than restructuring at close. At DirectMed, headcount grew eleven-fold under Mercury's ownership.",
  },
  {
    q: "Can I keep an ownership stake?",
    a: "Yes. Partial rollover is common and often preferable, allowing founders to participate in the next phase of growth alongside Mercury.",
  },
  {
    q: "How long does a transaction take?",
    a: "Typically 60 days to 6 months from first conversation to close, depending on complexity and the founder's timeline.",
  },
];
---

<Base
  title="Founder Legacy"
  description="We invest in businesses the way founders built them — for the long haul. Mercury preserves culture, values, people, and relationships."
>
  <section class="page-hero page-hero--dark pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">Why Mercury</span>
      <h1 class="h1">
        A Different Kind of <em>Investment Firm</em>
      </h1>
      <p class="lede muted">
        We invest in businesses the way founders built them — for the long haul.
      </p>
    </div></div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container split">
      <div>
        <span class="eyebrow">Legacy First</span>
        <h2 class="h2">
          What you built <em>endures</em>
        </h2>
        <p class="text-regular muted" style="margin-bottom: 1.5rem;">
          Mercury's first mandate is preserving a company's culture, values, people,
          and relationships. We believe the founder's vision and the bonds built over years
          matter more than quarterly returns.
        </p>
        <p class="text-regular muted" style="margin-bottom: 1.5rem;">
          A transition is more than a transaction. It affects employees, customers, culture, and
          legacy. Mercury approaches each investment with that responsibility in mind, working
          collaboratively with leadership to support long-term success while maintaining
          continuity.
        </p>
        <ul class="checklist">
          <li>Founder vision remains at the center</li>
          <li>People and relationships are protected</li>
          <li>Culture becomes the foundation for growth</li>
        </ul>
      </div>
      <div class="split__img">
        <img
          src="/images/founder-management-meeting-office.jpg"
          alt="Mercury Partners team meeting with a founder-owned business management team to discuss a long-term ownership transition"
          width="1400"
          height="1400"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section pad-global">
    <div class="container">
      {/* rendered inline rather than via SectionHeader so the lede can run wider than 48rem and hold one line */}
      <div style="margin-bottom: 4rem;">
        <span class="eyebrow" style="margin-bottom: 1rem;">After the Close</span>
        <h2 class="h2" style="max-width: 48rem; margin-bottom: 1.5rem;">
          What Changes, and <em>What Doesn't</em>
        </h2>
        <p class="lede muted" style="max-width: 56rem;">
          Founders want to know what happens the day after closing. Here is our answer, plainly.
        </p>
      </div>
      <div class="card-grid card-grid--2">
        <div class="card">
          <h3
            class="card__title"
            style="font-size: var(--text-body); margin-bottom: 1rem;"
          >
            What Stays the Same
          </h3>
          <ul class="plainlist">
            {
              stays.map((i) => (
                <li>
                  <strong>{i.lead}</strong> {i.body}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card">
          <h3
            class="card__title"
            style="font-size: var(--text-body); margin-bottom: 1rem;"
          >
            What Gets Stronger
          </h3>
          <ul class="plainlist">
            {
              strengthens.map((i) => (
                <li>
                  <strong>{i.lead}</strong> {i.body}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section pad-global on-navy">
    <div class="container">
      <SectionHeader
        eyebrow="What This Looks Like"
        lede="Mercury acquired DirectMed in 2017 as a founder-owned business. Over the following eight years, working alongside management:"
      >
        DirectMed Imaging: <em>Eight Years, One Partnership</em>
      </SectionHeader>
      <div style="color: var(--navy);">
        <StatBand
          bare
          stats={[
            { num: "9x", label: "Revenue Growth" },
            { num: "11x", label: "Headcount Growth" },
            { num: "7", label: "Acquisitions Completed" },
            { num: "8+", label: "New Markets Entered" },
          ]}
        />
      </div>
      <p class="text-regular muted" style="margin-top: 2.5rem; max-width: 65ch;">
        The founder's brand, team, and customer relationships stayed intact throughout. Growth
        came from investment and acquisition, not from cost reduction.
      </p>
    </div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container">
      <SectionHeader
        eyebrow="The Process"
        lede="Every situation is different. The sequence is not."
      >
        A Transition Built Around <em>the Founder</em>
      </SectionHeader>
      <div class="numeral-grid">
        {
          steps.map((s, i) => (
            <div style="border-top: 1px solid var(--border); padding-top: 1.4rem;">
              {/* sequential number inline before the title, in place of the short accent rule the other card groups use;
                  same font and size as the title, accent color only */}
              <h3 class="numeral-item__title">
                <span style="color: var(--orange); font-weight: 400; margin-right: 0.6rem;">
                  {i + 1}.
                </span>
                {s.title}
              </h3>
              <p class="numeral-item__body">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-grey">
    <div class="container faq-layout">
      <SectionHeader eyebrow="For Founders & Advisors">
        Common <em>Questions</em>
      </SectionHeader>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>
