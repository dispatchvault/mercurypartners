---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import StatBand from "../components/StatBand.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";

const stays = [
  {
    lead: "Your name and brand.",
    body: "We preserve the identity and market reputation that made the business successful.",
  },
  {
    lead: "Your team.",
    body: "We back management rather than replace it. Mercury partners with the leadership team rather than running the business day to day.",
  },
  {
    lead: "Your customer relationships.",
    body: "We build on the relationships and commercial practices that made the business successful rather than changing what already works.",
  },
  {
    lead: "Your culture.",
    body: "Culture is the hardest asset to rebuild and the easiest to destroy. We preserve the values and practices that already make your company successful.",
  },
];

const strengthens = [
  {
    lead: "Access to capital.",
    body: "Growth initiatives and acquisitions no longer compete with your personal balance sheet.",
  },
  {
    lead: "Systems and reporting.",
    body: "We invest in the systems and financial reporting needed to make fact-based decisions and support growth.",
  },
  {
    lead: "Strategic capability.",
    body: "A partner in the room for the decisions founders usually make alone: new growth initiatives, key management hires, acquisitions, and capital allocation.",
  },
  {
    lead: "An owner who has operated.",
    body: "Direct experience leading businesses through growth, credit crises, and periods of significant change informs how we invest and partner with management.",
  },
];

const steps = [
  {
    title: "A confidential conversation",
    body: "We learn about the business, what makes it distinctive, and what you want the outcome to look like.",
  },
  {
    title: "A direct answer on fit",
    body: "If Mercury is not the right partner, we say so quickly. A fast no is worth more to a founder than a slow maybe.",
  },
  {
    title: "A structure built to your goals",
    body: "Full exit, partial rollover, a defined transition period, or a continued board role. We discuss your objectives early and structure the transaction accordingly.",
  },
  {
    title: "Terms before diligence",
    body: "You receive written transaction terms reflecting the structure we discussed before beginning diligence. We align on the key terms before asking you to commit significant time to the process.",
  },
  {
    title: "Focused diligence",
    body: "We keep diligence focused and confidential so you can continue running the business.",
  },
  {
    title: "Continuity from day one",
    body: "Ownership changes at closing, but the strengths that made the business successful remain in place. From there, we work with management to support its next stage of growth.",
  },
];

const faqs = [
  {
    q: "How is Mercury different from a traditional private equity firm?",
    a: "Mercury invests its own permanent capital and is not constrained by a fund life or predetermined exit timeline. Our approach is also shaped by direct experience as both an investor and CEO, allowing us to bring an owner-operator perspective to each partnership.",
  },
  {
    q: "Will I need to stay on after the sale?",
    a: "It is one of the first things we discuss. Some founders want a clean exit at closing; others stay through a defined transition or retain a board role. We work with you to determine an approach that fits your objectives and the needs of the business.",
  },
  {
    q: "What happens to my employees?",
    a: "Mercury invests in businesses because of the people who built them. We back existing management and add depth and breadth to the team to support the company's next stage of growth.",
  },
  {
    q: "Can I keep an ownership stake?",
    a: "Yes. A transaction can include a partial rollover, allowing the founder to retain a minority ownership stake and participate in the next phase of growth alongside Mercury.",
  },
  {
    q: "Can my advisors be involved in the process?",
    a: "Absolutely. We welcome the involvement of a founder's trusted advisors and work directly with them throughout the transaction to keep the process efficient, transparent, and aligned with the founder's objectives.",
  },
  {
    q: "How long does a transaction take?",
    a: "Most transactions can be completed within 60 to 120 days, depending on the complexity of the business and the founder's objectives. We can move more quickly when circumstances require.",
  },
];
---

<Base
  title="For Founders"
  description="We invest in businesses the way founders built them — for the long haul. Mercury preserves culture, values, people, and relationships."
>
  <section class="page-hero page-hero--dark pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">For Founders</span>
      <h1 class="h1">
        A Different Kind of <em>Investment Firm</em>
      </h1>
      <p class="lede muted">
        We invest in businesses the way founders built them — for the long haul.
      </p>
    </div></div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container split">
      <div>
        <span class="eyebrow">Legacy First</span>
        <h2 class="h2">
          What you built <em>endures</em>
        </h2>
        <p class="text-regular muted" style="margin-bottom: 1.5rem;">
          Founders spend years building more than a business. They build a culture, a team,
          customer relationships, and a reputation that are worth preserving. Mercury approaches
          each investment with respect for what made the company successful and a commitment to
          building on that foundation.
        </p>
        <p class="text-regular muted" style="margin-bottom: 1.5rem;">
          A transition is more than a transaction. We work with leadership to maintain
          continuity while investing in the people, systems, and capabilities needed for the
          company's next stage of growth.
        </p>
        <ul class="checklist">
          <li>What makes the company distinctive remains intact</li>
          <li>People, culture, and customer relationships define the business</li>
          <li>Existing strengths become the foundation for growth</li>
        </ul>
      </div>
      <div class="split__img">
        <img
          src="/images/founder-management-meeting-office.jpg"
          alt="Mercury Partners team meeting with a founder-owned business management team to discuss a long-term ownership transition"
          width="1400"
          height="1400"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section pad-global">
    <div class="container">
      {/* rendered inline rather than via SectionHeader so the lede can run wider than 48rem and hold one line */}
      <div style="margin-bottom: 4rem;">
        <span class="eyebrow" style="margin-bottom: 1rem;">After the Close</span>
        <h2 class="h2" style="max-width: 48rem; margin-bottom: 1.5rem;">
          What Changes, and <em>What Doesn't</em>
        </h2>
        <p class="lede muted" style="max-width: 56rem;">
          Founders want to know what happens the day after closing. Here is our answer, plainly.
        </p>
      </div>
      <div class="card-grid card-grid--2">
        <div class="card">
          <h3
            class="card__title"
            style="font-size: var(--text-body); margin-bottom: 1rem;"
          >
            What Stays the Same
          </h3>
          <ul class="plainlist">
            {
              stays.map((i) => (
                <li>
                  <strong>{i.lead}</strong> {i.body}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card">
          <h3
            class="card__title"
            style="font-size: var(--text-body); margin-bottom: 1rem;"
          >
            What Gets Stronger
          </h3>
          <ul class="plainlist">
            {
              strengthens.map((i) => (
                <li>
                  <strong>{i.lead}</strong> {i.body}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section pad-global on-navy">
    <div class="container">
      <SectionHeader
        eyebrow="What This Looks Like"
        lede="Mercury acquired DirectMed in 2017 from its founders. Over the following eight years, working alongside management:"
      >
        DirectMed Imaging: <em>Eight Years, One Partnership</em>
      </SectionHeader>
      <div style="color: var(--navy);">
        <StatBand
          bare
          stats={[
            { num: "9x", label: "Revenue Growth" },
            { num: "11x", label: "Headcount Growth" },
            { num: "7", label: "Acquisitions Completed" },
            { num: "8+", label: "New Markets Entered" },
          ]}
        />
      </div>
      <p class="text-regular muted" style="margin-top: 2.5rem; max-width: 72ch;">
        DirectMed's brand, culture, and customer relationships remained intact throughout.
        Growth came from ongoing investment in people, capabilities, and strategic acquisitions.
      </p>
    </div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container">
      <SectionHeader
        eyebrow="The Process"
        lede="Every situation is different. The sequence is not."
      >
        A Transition Built Around <em>the Founder</em>
      </SectionHeader>
      <div class="numeral-grid">
        {
          steps.map((s, i) => (
            <div style="border-top: 1px solid var(--border); padding-top: 1.4rem;">
              {/* sequential number inline before the title, in place of the short accent rule the other card groups use;
                  same font and size as the title, accent color only */}
              <h3 class="numeral-item__title">
                <span style="color: var(--orange); font-weight: 400; margin-right: 0.6rem;">
                  {i + 1}.
                </span>
                {s.title}
              </h3>
              <p class="numeral-item__body">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-grey">
    <div class="container faq-layout">
      <SectionHeader eyebrow="For Founders & Advisors">
        Common <em>Questions</em>
      </SectionHeader>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand
    heading="Considering what's next for"
    accent="your business?"
    lede="Start with a confidential conversation about your objectives and what a transition could look like."
  />
</Base>
