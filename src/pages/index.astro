---
import Base from "../layouts/Base.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CtaBand from "../components/CtaBand.astro";

const principles = [
  {
    title: "Permanent Capital",
    body: "No fund timelines. No forced exits. We can own businesses indefinitely, allowing decisions to be driven by long-term value rather than liquidity deadlines.",
  },
  {
    title: "Founder Respect",
    body: "Founders have spent years building something worth protecting. We respect the vision, culture, people, and customer relationships that define each business.",
  },
  {
    title: "Growth Investment",
    body: "Growth is often limited by capital and material risk, not vision. We build on the opportunities founders have identified and put our own capital behind them.",
  },
];

const steps = [
  {
    title: "Identify",
    body: "We invest in founder-owned companies providing critical services to complex or regulated end markets, differentiated by technical expertise, high barriers to entry, and non-discretionary demand.",
  },
  {
    title: "Acquire",
    body: "We structure each transaction around the founder's objectives, with an emphasis on a thoughtful transition that respects the company's history, people, and culture.",
  },
  {
    title: "Build",
    body: "We invest behind management by expanding the leadership team, implementing new IT systems, pursuing organic growth initiatives, and completing strategic acquisitions.",
  },
  {
    title: "Partner",
    body: "We align management and ownership around long-term value creation, including opportunities for senior leaders to invest alongside Mercury and participate in equity incentives.",
  },
];

---

<Base
  description="Mercury Partners acquires and helps build founder-owned businesses across the lower middle market with permanent capital, founder respect, and growth investment."
>
  <section class="hero hero--dark pad-global">
    <div class="container hero__grid">
      <div>
        <span class="eyebrow">Lower Middle Market Partners</span>
        <h1 class="h1">
          We invest in and grow <em>founder-owned businesses.</em>
        </h1>
        <p class="lede muted">
          Mercury Partners is a principal investor focused on acquiring and building
          businesses in the lower middle market. We have over 30 years of experience investing
          in and leading private companies.
        </p>
        <div class="btn-group">
          <a href="/about" class="btn btn--secondary">ABOUT US</a>
          <a href="/contact" class="btn">START A CONVERSATION</a>
        </div>
        <div class="hero-stats">
          <div><div class="hero-stat__num">30+</div><div class="hero-stat__label">Years of Experience</div></div>
          <div><div class="hero-stat__num">24</div><div class="hero-stat__label">Investments</div></div>
          <div><div class="hero-stat__num">$10–50M</div><div class="hero-stat__label">Revenue Target</div></div>
        </div>
      </div>
      <div class="hero__art" aria-hidden="true">
        <div class="hero__img-main">
          <img
            src="/images/architecture.jpg"
            alt=""
            style="object-fit: cover; "
            loading="eager"
          />
        </div>
        <div class="hero__img-small">
          <img
            src="/images/radiologist-reviewing-diagnostic-imaging.jpg"
            alt="Radiologist reviewing diagnostic imaging scans, representing the healthcare services companies in the Mercury Partners portfolio"
            width="1000"
            height="1000"
            style="object-fit: cover;"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container">
      <SectionHeader
        eyebrow="Our Approach"
        lede="Permanent ownership. Founder respect. Growth investment. Mercury acquires and builds lower middle market businesses with a commitment to preserving what makes them great."
      >
        The Principles That <em>Guide Our Investments</em>
      </SectionHeader>
      <div class="card-grid card-grid--3">
        {
          principles.map((p) => (
            <div class="card card--hover">
              <h3 class="card__title">{p.title}</h3>
              <p class="card__body">{p.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global on-navy">
    <div class="container">
      <SectionHeader
        eyebrow="How We Invest"
        lede="Mercury Partners invests for the long term and works alongside management teams to carry forward what made the company successful. We preserve its culture and core strengths while investing in the people, systems, and capabilities needed for its next stage of growth."
      >
        Investing to grow while <em>maintaining your legacy</em>
      </SectionHeader>
      <div class="numeral-grid">
        {
          steps.map((s) => (
            <div class="numeral-item" style="border-top-color: var(--border-on-navy);">
              <h3 class="numeral-item__title">{s.title}</h3>
              <p class="numeral-item__body" style="color: var(--navy-tint);">
                {s.body}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section pad-global">
    <div class="container">
      <figure class="quote">
        <blockquote class="quote__text">
          “Mercury Partners was the logical partner to provide resources and team building
          capabilities to drive DirectMed's expansion. They also had deep respect for the
          culture we built and what made us successful.”
        </blockquote>
        <figcaption class="quote__attr">
          Bill Erbes <span class="quote__role">· Co-Founder and President, DirectMed Imaging</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <CtaBand
    heading="Considering what's next for"
    accent="your business?"
    lede="Every founder's situation is different. We're happy to start with a confidential conversation about your business, your objectives, and what a transition could look like."
    label="Start a Conversation"
  />
</Base>
