---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm.astro";
---

<Base
  title="Contact"
  description="Start a confidential conversation about your business and long-term goals with Mercury Partners."
>
  <section class="page-hero page-hero--dark pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">Get in Touch</span>
      <h1 class="h1">
        Let's <em>Talk</em>
      </h1>
      <p class="lede muted">
        Every conversation starts with understanding your business, your objectives, and what
        you're considering.
      </p>
    </div></div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container contact-grid">
      <div class="contact-info">
        <div>
          <div class="contact-info__label">Email</div>
          <a href="mailto:info@mercfund.com">info@mercfund.com</a>
        </div>
        <div>
          <div class="contact-info__label">Phone</div>
          {/* placeholder until the permanent number is confirmed; make it a tel: link then */}
          <p>(858) 555-XXXX</p>
        </div>
        <div>
          <div class="contact-info__label">Address</div>
          <p>
            12544 High Bluff Drive, Suite 200
            <br />
            San Diego, CA 92130
          </p>
        </div>
        <p class="contact-info__note">
          Every conversation is confidential. You don't need to have decided to sell your
          business — or even know exactly what a transition might look like. We're happy to
          start with a conversation.
        </p>
      </div>
      <div class="contact-form">
        <p class="lede" style="margin-bottom: 1.75rem;">
          Start a Conversation
        </p>
        <ContactForm />
      </div>
    </div>
  </section>
</Base>
