---
import Base from "../layouts/Base.astro";
import ContactForm from "../components/ContactForm";
---

<Base
  title="Contact"
  description="Start a confidential conversation about your business and long-term goals with Mercury Partners."
>
  <section class="page-hero page-hero--dark pad-global">
    <div class="container"><div class="page-hero__inner">
      <span class="eyebrow">Get in Touch</span>
      <h1 class="h1">
        Let's <em>Talk</em>
      </h1>
      <p class="lede muted">
        Start a confidential conversation about your business and long-term goals.
      </p>
    </div></div>
  </section>

  <section class="section pad-global scheme-cool">
    <div class="container contact-grid">
      <div class="contact-info">
        <div>
          <div class="contact-info__label">Email</div>
          <a href="mailto:info@mercfund.com">info@mercfund.com</a>
        </div>
        <div>
          <div class="contact-info__label">Address</div>
          <p>
            12544 High Bluff Drive, Suite 200
            <br />
            San Diego, CA 92130
          </p>
        </div>
        <p class="contact-info__note">
          All inquiries are handled with complete confidentiality. Whether you are a founder
          exploring a transition, an advisor representing a client, or an investment
          professional, we welcome the conversation.
        </p>
      </div>
      <div class="contact-form">
        <p class="lede" style="margin-bottom: 1.75rem;">
          Tell us about your business and what brings you here.
        </p>
        <ContactForm client:visible />
      </div>
    </div>
  </section>
</Base>
