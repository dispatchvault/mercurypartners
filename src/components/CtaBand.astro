---
interface Props {
  /* heading is split so the closing phrase can carry the serif italic accent */
  heading?: string;
  accent?: string;
  lede?: string;
  label?: string;
}

const {
  heading = "Ready to explore a",
  accent = "partnership?",
  lede = "We're here to discuss how Mercury can support your business transition.",
  label = "Let's Talk",
} = Astro.props;
---

<section class="cta-band pad-global section on-navy on-navy--deep">
  <div class="container cta-band__inner">
    <div>
      <h2 class="h3">
        {heading} <em>{accent}</em>
      </h2>
      <p class="lede muted">{lede}</p>
      <a href="/contact" class="btn btn--on-navy">{label}</a>
    </div>
  </div>
</section>
