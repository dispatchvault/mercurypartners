      <a href="/" class="footer__logo" aria-label="Mercury Partners home">
        <img src="/images/logo-white.png" alt="Mercury Partners" width="219" height="40" />
      </a>
      <nav class="footer__links" aria-label="Footer">
        <a href="/about">About</a>
        <a href="/founder-legacy">For Founders</a>
